#!/usr/bin/env bash
if command -v nvidia-smi >/dev/null 2>&1; then
 read -r temp util mem <<<"$(nvidia-smi --query-gpu=temperature.gpu,utilization.gpu,memory.used --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ',')"
 printf '{"text":"󰢮  %s°","tooltip":"Karta graficzna NVIDIA\\nObciążenie: %s%%\\nPamięć: %s MiB"}\n' "${temp:-?}" "${util:-?}" "${mem:-?}"
else printf '{"text":"󰢮  GPU","tooltip":"Brak telemetrii NVIDIA"}\n'; fi
