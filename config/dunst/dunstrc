[global]
    monitor = 0
    follow = mouse
    width = 400
    height = 125
    origin = top-right
    offset = 22x70
    progress_bar = true
    transparency = 6
    padding = 16
    horizontal_padding = 18
    frame_width = 2
    frame_color = "#DC0034"
    gap_size = 9
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    markup = full
    icon_position = left
    min_icon_size = 38
    max_icon_size = 50
    corner_radius = 12
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
[urgency_low]
    background = "#101114F2"
    foreground = "#A5A8B0"
    frame_color = "#34363D"
    timeout = 4
[urgency_normal]
    background = "#101114F5"
    foreground = "#F7F7F9"
    frame_color = "#DC0034"
    timeout = 7
[urgency_critical]
    background = "#19060CF8"
    foreground = "#FFFFFF"
    frame_color = "#FF355D"
    timeout = 0
